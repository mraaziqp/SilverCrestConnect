# ---------------------------------------------------------------------------
# Silver Crest Connect '26 — environment configuration
#
# Copy to .env and fill in. .env is gitignored: never commit real credentials.
# ---------------------------------------------------------------------------

# Public base URL of this deployment. PayFast builds its return, cancel and
# ITN callback URLs from this, so it MUST be the real public HTTPS address in
# production — PayFast cannot reach localhost.
APP_URL="http://localhost:3000"   # production: https://scconnect.co.za

# --- PayFast -----------------------------------------------------------------
# "sandbox" uses PayFast's test gateway; "live" takes real money.
# Keep this on sandbox until an end-to-end test payment has succeeded.
PAYFAST_MODE="sandbox"

# From the PayFast dashboard: Settings -> Integration.
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""

# Optional but STRONGLY recommended for live: set the same passphrase here and
# in the PayFast dashboard. Without it, signatures are weaker.
PAYFAST_PASSPHRASE=""

# Local-testing escape hatches. Both MUST stay unset (or "false") in production
# — they disable ITN source-IP checking and PayFast server confirmation.
PAYFAST_SKIP_IP_CHECK=""
PAYFAST_SKIP_SERVER_CONFIRM=""

# --- Email (SMTP) ------------------------------------------------------------
# Microsoft 365. SMTP_HOST takes priority over RESEND_API_KEY; with neither
# set, emails are logged to the server console instead of sent.
#
# Two things must be true on the Microsoft side or sending fails:
#   1. SMTP AUTH must be ENABLED for this mailbox. It is OFF by default on new
#      tenants: Microsoft 365 admin -> Users -> Active users -> pick the user
#      -> Mail -> Manage email apps -> tick "Authenticated SMTP".
#   2. If the account has MFA, SMTP_PASS must be an APP PASSWORD, not the
#      normal sign-in password.
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# EMAIL_FROM must match SMTP_USER, or be an alias that mailbox holds "Send As"
# rights on. Microsoft rejects anything else with error 5.7.60.
EMAIL_FROM=""
EMAIL_FROM_NAME="Silver Crest Connect"
EMAIL_REPLY_TO=""

# Staging safety valve: redirects EVERY email here regardless of recipient,
# so a test run cannot mail real applicants. Leave empty in production.
EMAIL_REDIRECT_TO=""

# Alternative provider, used only when SMTP_HOST is empty.
RESEND_API_KEY=""

# --- Admin dashboard ---------------------------------------------------------
# Long random string. Without it, /admin is disabled entirely (fail closed).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=""

# --- Storage -----------------------------------------------------------------
# Firestore is used automatically when credentials are present; otherwise the
# app falls back to a local JSON file.
#
# The JSON file is fine on a host with a real disk, but NOT on serverless
# (Vercel), where writes are discarded between requests and a paid ticket can
# be lost. /api/health reports which is in effect.
STORE_DRIVER=""

# Either a path to the service-account JSON...
GOOGLE_APPLICATION_CREDENTIALS=""
# ...or the JSON itself, on one line, for hosts that only take env vars.
FIREBASE_SERVICE_ACCOUNT=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""

# --- Server ------------------------------------------------------------------
PORT="3000"
# Where the JSON datastore is written. Must be a writable, persistent path.
DATA_DIR=""
